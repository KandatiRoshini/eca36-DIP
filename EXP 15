clc;
clear;
close all;

%% =========================================================
%  PART A: ENTROPY AND HUFFMAN CODING
%  =========================================================

% Read grayscale image
I = imread('cameraman.tif');

%% 1. Calculate Probability Distribution

% Calculate histogram probability
p = imhist(I) / numel(I);

% Find gray levels having non-zero probability
sym = find(p > 0) - 1;

% Extract corresponding probabilities
prob = p(p > 0);


%% 2. Calculate Image Entropy

H = -sum(prob .* log2(prob));


%% 3. Generate Huffman Dictionary

dict = huffmandict(sym, prob);


%% 4. Huffman Encoding

code = huffmanenco(double(I(:)), dict);


%% 5. Huffman Decoding

dec = huffmandeco(code, dict);


%% 6. Calculate Coding Parameters

Lavg = numel(code) / numel(I);

codingEfficiency = 100 * H / Lavg;

compressionRatio = 8 / Lavg;


%% 7. Display Huffman Results

fprintf('\n============================================\n');
fprintf('          HUFFMAN CODING RESULTS\n');
fprintf('============================================\n');

fprintf('Entropy = %.4f bits/pixel\n', H);

fprintf('Average code length = %.4f bits/pixel\n', ...
    Lavg);

fprintf('Coding efficiency = %.2f%%\n', ...
    codingEfficiency);

fprintf('Compression ratio = %.3f\n', ...
    compressionRatio);

fprintf('Lossless decoding = %d\n', ...
    isequal(dec(:), double(I(:))));


%% 8. Display Five Most Probable Gray Levels

[~, ord] = sort(prob, 'descend');

disp('Five most probable gray levels:');

for k = 1:min(5, numel(ord))

    fprintf('Level %3d, Probability = %.4f, Code = %s\n', ...
        dict{ord(k),1}, ...
        prob(ord(k)), ...
        num2str(dict{ord(k),2}, '%d'));

end


%% =========================================================
%  PART B: RUN-LENGTH CODING
%  =========================================================

% Read binary image
BW = imread('text.png');


%% 1. Convert Image into One-Dimensional Sequence

x = reshape(BW', 1, []);


%% 2. Find Locations Where Pixel Value Changes

s = [true, diff(x) ~= 0];


%% 3. Extract Pixel Values

val = x(s);


%% 4. Calculate Run Lengths

runs = diff([find(s), numel(x) + 1]);


%% 5. Reconstruct Image Sequence

rec = repelem(val, runs);


%% 6. Calculate Bits Required for Run Length

bitsPerRun = ceil(log2(max(runs) + 1));


%% 7. Calculate Compression Ratio

CRrle = numel(x) / ...
    (numel(runs) * bitsPerRun + 1);


%% 8. Display RLE Results

fprintf('\n============================================\n');
fprintf('       RUN-LENGTH CODING RESULTS\n');
fprintf('============================================\n');

fprintf('Number of runs = %d\n', ...
    numel(runs));

fprintf('Bits per run length = %d\n', ...
    bitsPerRun);

fprintf('Compression ratio = %.2f\n', ...
    CRrle);

fprintf('Lossless decoding = %d\n', ...
    isequal(rec, x));


%% 9. Display First 20 Run Lengths

disp('First 20 run lengths:');

disp(runs(1:min(20, numel(runs))));


%% =========================================================
%  PART C: ARITHMETIC CODING
%  =========================================================

%% 1. Define Input Symbol Sequence

seq = [1 2 1 1 3 1 2 1 1 1 3 2 1 1];


%% 2. Calculate Symbol Frequencies

counts = accumarray(seq(:), 1)';


%% 3. Arithmetic Encoding

acode = arithenco(seq, counts);


%% 4. Arithmetic Decoding

dseq = arithdeco(acode, ...
                 counts, ...
                 numel(seq));


%% 5. Calculate Bits per Symbol

bitsPerSymbol = numel(acode) / numel(seq);


%% 6. Display Arithmetic Coding Results

fprintf('\n============================================\n');
fprintf('         ARITHMETIC CODING RESULTS\n');
fprintf('============================================\n');

fprintf('Number of symbols = %d\n', ...
    numel(seq));

fprintf('Encoded bits = %d\n', ...
    numel(acode));

fprintf('Bits/symbol = %.2f\n', ...
    bitsPerSymbol);

fprintf('Decoded correctly = %d\n', ...
    isequal(seq, dseq));


%% =========================================================
%  PROGRAM COMPLETION
%  =========================================================

fprintf('\n============================================\n');
fprintf('   IMAGE COMPRESSION ANALYSIS COMPLETED\n');
fprintf('============================================\n');

fprintf('Huffman coding completed successfully.\n');
fprintf('Run-Length coding completed successfully.\n');
fprintf('Arithmetic coding completed successfully.\n');
