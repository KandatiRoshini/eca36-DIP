clc;
clear;
close all;

%% =========================================================
%  PART A: PERIODIC NOISE REMOVAL
%  =========================================================

%% 1. Read Input Image

I = im2double(imread('cameraman.tif'));

% Get image dimensions
[M, N] = size(I);

%% 2. Generate Periodic Noise

[x, y] = meshgrid(1:N, 1:M);

% Add sinusoidal periodic noise
In = I + 0.2 * sin(2*pi*(x/8 + y/8));


%% 3. Compute Frequency Spectrum

F = fftshift(fft2(In));

% Create frequency coordinates
[u, v] = meshgrid(-N/2:N/2-1, ...
                  -M/2:M/2-1);


%% 4. Define Notch Reject Filter Parameters

D0 = 10;       % Notch bandwidth
n = 4;         % Filter order

% Noise frequency locations
uk = N/8;
vk = M/8;


%% 5. Calculate Notch Filter Distances

Dk1 = sqrt((u-uk).^2 + ...
           (v-vk).^2);

Dk2 = sqrt((u+uk).^2 + ...
           (v+vk).^2);


%% 6. Create Notch Reject Filter

Hnr = (1 ./ (1 + (D0 ./ Dk1).^(2*n))) .* ...
      (1 ./ (1 + (D0 ./ Dk2).^(2*n)));


%% 7. Create Band Reject Filter

D = sqrt(u.^2 + v.^2);

C0 = sqrt(uk^2 + vk^2);

W = 10;

Hbr = 1 - exp(-((D.^2 - C0^2) ./ ...
                (D * W)).^2);


%% 8. Apply Notch Reject Filter

gNotch = real(ifft2(ifftshift(F .* Hnr)));


%% 9. Apply Band Reject Filter

gBand = real(ifft2(ifftshift(F .* Hbr)));


%% 10. Display Periodic Noise Removal Results

figure('Name','Periodic Noise Removal');

subplot(2,3,1);
imshow(In, []);
title('Noisy Image');

subplot(2,3,2);
imshow(log(1 + abs(F)), []);
title('Frequency Spectrum');

subplot(2,3,3);
imshow(Hnr, []);
title('Notch Reject Filter');

subplot(2,3,4);
imshow(gNotch, []);
title('Notch Output');

subplot(2,3,5);
imshow(Hbr, []);
title('Band Reject Filter');

subplot(2,3,6);
imshow(gBand, []);
title('Band Reject Output');


%% =========================================================
%  PART B: IMAGE DEBLURRING
%  =========================================================

%% 1. Create Motion Blur PSF

PSF = fspecial('motion', 21, 11);


%% 2. Generate Motion-Blured Image

blur = imfilter(I, PSF, ...
                'conv', ...
                'circular');


%% 3. Add Gaussian Noise

nvar = 1e-4;

gb = imnoise(blur, ...
             'gaussian', ...
             0, ...
             nvar);


%% 4. Inverse Filtering

fInv = deconvwnr(gb, PSF, 0);


%% 5. Calculate Noise-to-Signal Ratio

NSR = nvar / var(I(:));


%% 6. Wiener Filtering

fWnr = deconvwnr(gb, PSF, NSR);


%% 7. Lucy-Richardson Deconvolution

fLR = deconvlucy(gb, PSF, 20);


%% 8. Display Deblurring Results

figure('Name','Image Deblurring');

subplot(2,3,1);
imshow(I);
title('Original');

subplot(2,3,2);
imshow(blur);
title('Motion Blurred');

subplot(2,3,3);
imshow(gb);
title('Blurred + Noise');

subplot(2,3,4);
imshow(fInv, []);
title('Inverse Filtering');

subplot(2,3,5);
imshow(fWnr, []);
title('Wiener Filtering');

subplot(2,3,6);
imshow(fLR, []);
title('Lucy-Richardson');


%% =========================================================
%  PART C: PROGRAM COMPLETION
%  =========================================================

fprintf('\n============================================\n');
fprintf(' IMAGE RESTORATION COMPLETED SUCCESSFULLY\n');
fprintf('============================================\n');

fprintf('Periodic noise removal completed.\n');
fprintf('Notch reject filtering completed.\n');
fprintf('Band reject filtering completed.\n');
fprintf('Motion blur generation completed.\n');
fprintf('Inverse filtering completed.\n');
fprintf('Wiener filtering completed.\n');
fprintf('Lucy-Richardson deconvolution completed.\n');
