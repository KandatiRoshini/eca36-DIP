clc;
clear;
close all;

%% =========================================================
%  PART A: BINARY DILATION AND EROSION
%  =========================================================

% Read binary image
BW = imread('text.png');

% Create structuring element
se = strel('square', 3);


%% Apply Binary Dilation

BW_dilation = imdilate(BW, se);


%% Apply Binary Erosion

BW_erosion = imerode(BW, se);


%% Display Dilation and Erosion

figure('Name','Dilation and Erosion');

subplot(1,3,1);
imshow(BW);
title('Original');

subplot(1,3,2);
imshow(BW_dilation);
title('Dilation');

subplot(1,3,3);
imshow(BW_erosion);
title('Erosion');


%% =========================================================
%  PART B: MORPHOLOGICAL OPENING AND CLOSING
%  =========================================================

% Read binary circles image
A = logical(imread('circles.png'));

% Create noisy version of image
N = A;

% Generate random noise locations
idx = rand(size(A)) < 0.03;

% Add salt-and-pepper type binary noise
N(idx) = ~N(idx);


%% Create Disk Structuring Element

sd = strel('disk', 3);


%% Morphological Opening

O = imopen(N, sd);


%% Morphological Closing

OC = imclose(O, sd);


%% Display Opening and Closing

figure('Name','Opening and Closing');

subplot(2,2,1);
imshow(A);
title('Original');

subplot(2,2,2);
imshow(N);
title('Noisy Image');

subplot(2,2,3);
imshow(O);
title('Opening');

subplot(2,2,4);
imshow(OC);
title('Opening and Closing');


%% =========================================================
%  PART C: BOUNDARY EXTRACTION
%  =========================================================

% Create square structuring element
se_boundary = strel('square', 3);

% Extract boundary using morphological erosion
Bd = A & ~imerode(A, se_boundary);


%% Display Boundary

figure('Name','Boundary Extraction');

imshow(Bd);
title('Boundary of Circles');


%% =========================================================
%  PART D: GRAYSCALE MORPHOLOGY
%  =========================================================

% Read grayscale image
G = imread('cameraman.tif');

% Read rice image
R = imread('rice.png');

% Create grayscale structuring element
sg = strel('disk', 3);


%% Apply Grayscale Morphological Operations

G_dilation = imdilate(G, sg);

G_erosion = imerode(G, sg);

G_opening = imopen(G, sg);

G_closing = imclose(G, sg);


%% =========================================================
%  PART E: TOP-HAT TRANSFORM
%  =========================================================

% Create structuring element for Top-Hat transform
se_tophat = strel('disk', 15);

% Apply Top-Hat transformation
TopHat = imtophat(R, se_tophat);


%% =========================================================
%  PART F: DISPLAY GRAYSCALE MORPHOLOGY
%  =========================================================

figure('Name','Grayscale Morphology');

subplot(2,3,1);
imshow(G);
title('Original');

subplot(2,3,2);
imshow(G_dilation);
title('Dilation');

subplot(2,3,3);
imshow(G_erosion);
title('Erosion');

subplot(2,3,4);
imshow(G_opening);
title('Opening');

subplot(2,3,5);
imshow(G_closing);
title('Closing');

subplot(2,3,6);
imshow(TopHat);
title('Top-Hat Transform');


%% =========================================================
%  PROGRAM COMPLETION
%  =========================================================

fprintf('\n============================================\n');
fprintf(' MORPHOLOGICAL IMAGE PROCESSING COMPLETED\n');
fprintf('============================================\n');

fprintf('Binary dilation completed.\n');
fprintf('Binary erosion completed.\n');
fprintf('Opening completed.\n');
fprintf('Closing completed.\n');
fprintf('Boundary extraction completed.\n');
fprintf('Grayscale morphology completed.\n');
fprintf('Top-Hat transformation completed.\n');
