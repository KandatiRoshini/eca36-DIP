clc;
clear;
close all;

%% 1. Read RGB Image
RGB = imread('peppers.png');

%% 2. Extract RGB Components
R = RGB(:,:,1);
G = RGB(:,:,2);
B = RGB(:,:,3);

% Create zero matrix for displaying individual colour channels
Z = zeros(size(R), 'uint8');

%% 3. RGB Colour Model

figure('Name','RGB Colour Components');

% Original and colour components
subplot(2,4,1);
imshow(RGB);
title('Original Image');

subplot(2,4,2);
imshow(cat(3,R,Z,Z));
title('Red Component');

subplot(2,4,3);
imshow(cat(3,Z,G,Z));
title('Green Component');

subplot(2,4,4);
imshow(cat(3,Z,Z,B));
title('Blue Component');

% Intensity images
subplot(2,4,6);
imshow(R);
title('Red Intensity');

subplot(2,4,7);
imshow(G);
title('Green Intensity');

subplot(2,4,8);
imshow(B);
title('Blue Intensity');

%% 4. CMY Colour Model
% CMY is obtained by complementing the RGB image

CMY = imcomplement(RGB);

figure('Name','CMY Colour Model');

subplot(1,4,1);
imshow(CMY);
title('CMY Image');

subplot(1,4,2);
imshow(CMY(:,:,1));
title('Cyan');

subplot(1,4,3);
imshow(CMY(:,:,2));
title('Magenta');

subplot(1,4,4);
imshow(CMY(:,:,3));
title('Yellow');

%% 5. HSV Colour Model
HSV = rgb2hsv(RGB);

figure('Name','HSV Colour Model');

subplot(1,3,1);
imshow(HSV(:,:,1));
title('Hue');

subplot(1,3,2);
imshow(HSV(:,:,2));
title('Saturation');

subplot(1,3,3);
imshow(HSV(:,:,3));
title('Value');

%% 6. YCbCr Colour Model
YCC = rgb2ycbcr(RGB);

figure('Name','YCbCr Colour Model');

subplot(1,3,1);
imshow(YCC(:,:,1));
title('Y - Luminance');

subplot(1,3,2);
imshow(YCC(:,:,2));
title('Cb - Blue Chrominance');

subplot(1,3,3);
imshow(YCC(:,:,3));
title('Cr - Red Chrominance');

%% 7. Display Pixel Values
% Select a particular pixel location

r = 200;
c = 300;

fprintf('\n----- PIXEL VALUES -----\n');

fprintf('Pixel Location : Row = %d, Column = %d\n', r, c);

fprintf('RGB   = [%d %d %d]\n', ...
    RGB(r,c,1), RGB(r,c,2), RGB(r,c,3));

fprintf('CMY   = [%d %d %d]\n', ...
    CMY(r,c,1), CMY(r,c,2), CMY(r,c,3));

fprintf('HSV   = [%.3f %.3f %.3f]\n', ...
    HSV(r,c,1), HSV(r,c,2), HSV(r,c,3));

fprintf('YCbCr = [%d %d %d]\n', ...
    YCC(r,c,1), YCC(r,c,2), YCC(r,c,3));

%% 8. Enhance Colour Saturation
HSV2 = HSV;

% Increase saturation by 50%
HSV2(:,:,2) = min(1.5 * HSV(:,:,2), 1);

% Convert enhanced HSV image back to RGB
EnhancedRGB = hsv2rgb(HSV2);

%% 9. Display Original and Enhanced Images
figure('Name','Colour Saturation Enhancement');

subplot(1,2,1);
imshow(RGB);
title('Original Image');

subplot(1,2,2);
imshow(EnhancedRGB);
title('Enhanced Saturation');

%% 10. Program Completion
fprintf('\nColour model conversion and enhancement completed successfully!\n');
