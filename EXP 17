clc;
clear;
close all;

%% =========================================================
%  PART A: READ IMAGE AND PREPARE DCT
%  =========================================================

% Read grayscale image
I = imread('cameraman.tif');

% Convert image to double and shift intensity range
X = double(I) - 128;

% Create 8 x 8 DCT transformation matrix
T = dctmtx(8);


%% =========================================================
%  PART B: 8 x 8 BLOCK DCT
%  =========================================================

% Apply DCT to each 8 x 8 image block
C = blockproc(X, [8 8], ...
    @(b) T * b.data * T');


%% Display Block DCT Result

figure('Name', 'Block DCT');

subplot(1,2,1);
imshow(I);
title('Original');

subplot(1,2,2);
imshow(log(1 + abs(C)), []);
title('8x8 Block DCT');


%% =========================================================
%  PART C: JPEG QUANTIZATION MATRIX
%  =========================================================

% Standard JPEG luminance quantization matrix
Q50 = [16 11 10 16 24 40 51 61;
       12 12 14 19 26 58 60 55;
       14 13 16 24 40 57 69 56;
       14 17 22 29 51 87 80 62;
       18 22 37 56 68 109 103 77;
       24 35 55 64 81 104 113 92;
       49 64 78 87 103 121 120 101;
       72 92 95 98 112 100 103 99];


%% Define JPEG Quality Levels

quality = [90 50 25 10];


%% =========================================================
%  PART D: JPEG-STYLE DCT QUANTIZATION
%  =========================================================

figure('Name', 'DCT Compression');

fprintf('\n===============================================\n');
fprintf('       JPEG-STYLE DCT COMPRESSION\n');
fprintf('===============================================\n');

fprintf('Quality  Non-zero Coeffs  Approx. CR  PSNR (dB)\n');


%% Process Each Quality Level

for k = 1:numel(quality)

    % Select quality factor
    q = quality(k);


    %% Calculate Quantization Scaling Factor

    if q < 50
        s = 5000 / q;
    else
        s = 200 - 2 * q;
    end


    %% Generate Scaled Quantization Matrix

    Q = max(floor((Q50 * s + 50) / 100), 1);


    %% Quantize DCT Coefficients

    Cq = blockproc(X, [8 8], ...
        @(b) round((T * b.data * T') ./ Q));


    %% =====================================================
    %  PART E: DCT DEQUANTIZATION AND RECONSTRUCTION
    %  =====================================================

    Xr = blockproc(Cq, [8 8], ...
        @(b) T' * (b.data .* Q) * T);


    %% Convert Back to uint8 Image

    R = uint8(Xr + 128);


    %% Calculate Compression Ratio

    CR = numel(I) / nnz(Cq);


    %% Calculate PSNR

    P = psnr(R, I);


    %% Display Results in Command Window

    fprintf('%5d %15d %11.2f %11.2f\n', ...
        q, ...
        nnz(Cq), ...
        CR, ...
        P);


    %% Display Reconstructed Image

    subplot(2,2,k);

    imshow(R);

    title(sprintf('Quality %d, PSNR = %.1f dB', ...
        q, P));

end


%% =========================================================
%  PART F: STANDARD JPEG COMPRESSION
%  =========================================================

fprintf('\n===============================================\n');
fprintf('          STANDARD JPEG COMPRESSION\n');
fprintf('===============================================\n');


% JPEG Quality 90
q = 90;

fname = sprintf('cameraman_q%d.jpg', q);

imwrite(I, fname, 'Quality', q);

d = dir(fname);

fprintf('JPEG Quality %d: File size = %d bytes\n', ...
    q, d.bytes);


% JPEG Quality 50
q = 50;

fname = sprintf('cameraman_q%d.jpg', q);

imwrite(I, fname, 'Quality', q);

d = dir(fname);

fprintf('JPEG Quality %d: File size = %d bytes\n', ...
    q, d.bytes);


% JPEG Quality 10
q = 10;

fname = sprintf('cameraman_q%d.jpg', q);

imwrite(I, fname, 'Quality', q);

d = dir(fname);

fprintf('JPEG Quality %d: File size = %d bytes\n', ...
    q, d.bytes);


